@startuml 01-casos-de-uso-pacientes
' =====================================================================
' Diagrama de Casos de Uso
' Modulo: Pacientes - registro, edicion, busqueda y detalle
' Proceso: registro, busqueda y actualizacion segura de un paciente
' Autora: Glendi Patricia Campos Orellana
' =====================================================================
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Recepcionista" as Recepcionista
actor "Administrador" as Administrador
actor "Sistema RBAC\n(autorizacion)" as RBAC <<system>>
actor "Sistema de Auditoria" as Auditoria <<system>>

Administrador --|> Recepcionista

rectangle "Sistema de Gestion de Pacientes" {
  usecase "UC1 Registrar paciente"              as UC1
  usecase "UC2 Buscar paciente"                 as UC2
  usecase "UC3 Actualizar paciente"             as UC3
  usecase "UC4 Ver detalle de paciente"         as UC4
  usecase "UC5 Validar duplicidad de paciente"  as UC5
  usecase "UC6 Verificar permisos de usuario"   as UC6
  usecase "UC7 Registrar evento de auditoria"   as UC7

  note top of UC1
    Objetivo del proceso: garantizar que el
    registro, la busqueda y la actualizacion
    de los datos de un paciente se realicen
    de forma valida, autorizada y trazable.
  end note
}

Recepcionista -- UC1
Recepcionista -- UC2
Recepcionista -- UC3
Recepcionista -- UC4

UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<include>>
UC1 ..> UC7 : <<include>>
UC3 ..> UC6 : <<include>>
UC3 ..> UC7 : <<include>>
UC2 ..> UC4 : <<extend>>

UC6 ..> UC7 : <<extend>>\n(intento denegado)

RBAC -- UC6
Auditoria -- UC7

@enduml
